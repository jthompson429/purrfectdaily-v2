{
  "name": "NeonatalMotherLog",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this mother log belongs to"
    },
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten (mother of)"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "ate": {
      "type": "boolean",
      "default": false
    },
    "drank_water": {
      "type": "boolean",
      "default": false
    },
    "food_notes": {
      "type": "string"
    },
    "nursing_observed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "maybe"
      ],
      "default": "yes"
    },
    "behavior_notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}