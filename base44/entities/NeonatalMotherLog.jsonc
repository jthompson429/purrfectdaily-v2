{
  "name": "NeonatalMotherLog",
  "type": "object",
  "properties": {
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten (mother of)"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "ate": {
      "type": "boolean",
      "default": false
    },
    "drank_water": {
      "type": "boolean",
      "default": false
    },
    "food_notes": {
      "type": "string"
    },
    "nursing_observed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "maybe"
      ],
      "default": "yes"
    },
    "behavior_notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}