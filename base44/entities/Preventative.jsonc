{
  "name": "Preventative",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this preventative record belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date_given": {
      "type": "string",
      "format": "date"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "every_3_months",
        "annual",
        "custom"
      ],
      "default": "monthly"
    },
    "custom_interval_days": {
      "type": "number",
      "description": "Used when frequency is 'custom'"
    },
    "notes": {
      "type": "string"
    },
    "source_visit_id": {
      "type": "string",
      "description": "Vet visit that generated this record; blank for independently entered preventatives"
    }
  },
  "required": [
    "pet_id",
    "name",
    "date_given",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}