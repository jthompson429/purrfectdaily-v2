{
  "name": "Preventative",
  "type": "object",
  "properties": {
    "pet_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "date_given": {
      "type": "string",
      "format": "date"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "every_3_months",
        "annual",
        "custom"
      ],
      "default": "monthly"
    },
    "custom_interval_days": {
      "type": "number",
      "description": "Used when frequency is 'custom'"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pet_id",
    "name",
    "date_given"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}