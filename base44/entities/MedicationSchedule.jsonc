{
  "name": "MedicationSchedule",
  "type": "object",
  "properties": {
    "pet_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "dosage_instructions": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "eye_drop",
        "food",
        "topical",
        "other"
      ],
      "default": "oral"
    },
    "frequency": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "daily",
        "alternate_weeks",
        "specific_days",
        "custom"
      ],
      "default": "daily"
    },
    "active_week_pattern": {
      "type": "string",
      "description": "e.g. '1,3,5' for weeks 1, 3, 5 on"
    },
    "off_week_warning": {
      "type": "string"
    },
    "critical": {
      "type": "boolean",
      "default": true
    },
    "requires_photo": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "medication_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}