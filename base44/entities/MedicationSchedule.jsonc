{
  "name": "MedicationSchedule",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this medication schedule belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "dosage_instructions": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "eye_drop",
        "food",
        "topical",
        "other"
      ],
      "default": "oral"
    },
    "frequency": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "daily",
        "alternate_weeks",
        "specific_days",
        "custom"
      ],
      "default": "daily"
    },
    "active_week_pattern": {
      "type": "string",
      "description": "e.g. '1,3,5' for weeks 1, 3, 5 on"
    },
    "off_week_warning": {
      "type": "string"
    },
    "schedule_days": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "description": "Weekdays for specific_days schedules, where 0 is Sunday and 6 is Saturday"
    },
    "custom_schedule_instructions": {
      "type": "string",
      "description": "Human-readable instructions for schedules that cannot be calculated automatically"
    },
    "critical": {
      "type": "boolean",
      "default": true
    },
    "requires_photo": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "source_visit_id": {
      "type": "string",
      "description": "Vet visit that generated this medication schedule; blank for independently entered medications"
    },
    "doses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "morning": {
            "type": "boolean",
            "default": false
          },
          "afternoon": {
            "type": "boolean",
            "default": false
          },
          "evening": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "medication_name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}