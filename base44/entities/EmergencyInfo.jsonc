{
  "name": "EmergencyInfo",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this emergency info belongs to"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "owner",
        "backup_owner",
        "primary_vet",
        "emergency_vet",
        "other"
      ],
      "default": "other"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "contact_name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}