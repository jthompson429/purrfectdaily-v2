{
  "name": "WeightLog",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this weight log belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "weight": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pet_id",
    "weight",
    "date",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}