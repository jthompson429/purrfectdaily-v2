{
  "name": "NeonatalFeeding",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this feeding log belongs to"
    },
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "amount_ml": {
      "type": "number",
      "default": 0
    },
    "method": {
      "type": "string",
      "enum": [
        "syringe",
        "bottle",
        "nursing",
        "mixed"
      ],
      "default": "syringe"
    },
    "nursing_observed": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "maybe"
      ],
      "default": "maybe"
    },
    "suck_strength": {
      "type": "string",
      "enum": [
        "strong",
        "weak",
        "none"
      ],
      "default": "strong"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}