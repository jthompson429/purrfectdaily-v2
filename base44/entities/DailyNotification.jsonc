{
  "name": "DailyNotification",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this notification belongs to"
    },
    "notification_date": {
      "type": "string",
      "format": "date",
      "description": "The date this notification was sent"
    },
    "type": {
      "type": "string",
      "enum": [
        "daily_complete",
        "problem_reported"
      ],
      "default": "daily_complete"
    },
    "sent": {
      "type": "boolean",
      "default": false
    },
    "sent_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "notification_date",
    "type",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}