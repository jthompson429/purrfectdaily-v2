{
  "name": "DailyNotification",
  "type": "object",
  "properties": {
    "notification_date": {
      "type": "string",
      "format": "date",
      "description": "The date this notification was sent"
    },
    "type": {
      "type": "string",
      "enum": [
        "daily_complete",
        "problem_reported"
      ],
      "default": "daily_complete"
    },
    "sent": {
      "type": "boolean",
      "default": false
    },
    "sent_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "notification_date",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}