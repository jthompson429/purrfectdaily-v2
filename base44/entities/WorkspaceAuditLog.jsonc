{
  "name": "WorkspaceAuditLog",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "actor_email": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "action",
    "event_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}