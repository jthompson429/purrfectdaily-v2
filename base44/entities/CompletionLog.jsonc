{
  "name": "CompletionLog",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this log belongs to"
    },
    "task_id": {
      "type": "string"
    },
    "pet_id": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "skipped",
        "not_applicable"
      ],
      "default": "done"
    },
    "photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "completed_by": {
      "type": "string"
    },
    "original_status": {
      "type": "string",
      "enum": [
        "done",
        "skipped",
        "not_applicable"
      ]
    },
    "corrected_at": {
      "type": "string"
    },
    "corrected_by": {
      "type": "string"
    },
    "correction_reason": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "completion_date",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}