{
  "name": "Vaccination",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this vaccination belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "enum": [
        "rabies",
        "fvrcp",
        "felv",
        "custom"
      ],
      "default": "rabies"
    },
    "custom_name": {
      "type": "string"
    },
    "date_given": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "veterinarian": {
      "type": "string"
    },
    "lot_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "pet_id",
    "date_given",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}