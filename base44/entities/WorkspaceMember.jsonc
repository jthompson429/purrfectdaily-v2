{
  "name": "WorkspaceMember",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "caregiver",
        "viewer"
      ],
      "default": "caregiver"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "clipboard_in_app_alerts": {
      "type": "boolean",
      "default": true,
      "description": "Receive urgent Digital Clipboard notifications in the app"
    }
  },
  "required": [
    "workspace_id",
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        }
      ]
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}