{
  "name": "PayConfig",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this pay config belongs to"
    },
    "daily_pay_amount": {
      "type": "number",
      "default": 100,
      "description": "Amount paid per fully completed care day"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner email to receive completion notifications"
    },
    "owner_name": {
      "type": "string",
      "description": "Owner name shown in notifications"
    },
    "trip_start_date": {
      "type": "string",
      "format": "date",
      "description": "First day of the trip / care period"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}