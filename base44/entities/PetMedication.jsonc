{
  "name": "PetMedication",
  "type": "object",
  "properties": {
    "pet_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once_daily",
        "twice_daily",
        "thrice_daily",
        "as_needed"
      ],
      "default": "twice_daily"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "doses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "morning": {
            "type": "boolean",
            "default": false
          },
          "afternoon": {
            "type": "boolean",
            "default": false
          },
          "evening": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "pet_id",
    "medication_name",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}