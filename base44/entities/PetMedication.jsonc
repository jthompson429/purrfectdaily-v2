{
  "name": "PetMedication",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this medication belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "medication_name": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once_daily",
        "twice_daily",
        "thrice_daily",
        "as_needed"
      ],
      "default": "twice_daily"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "doses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "morning": {
            "type": "boolean",
            "default": false
          },
          "afternoon": {
            "type": "boolean",
            "default": false
          },
          "evening": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "pet_id",
    "medication_name",
    "start_date",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}