{
  "name": "VetVisit",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this vet visit belongs to"
    },
    "pet_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clinic": {
      "type": "string"
    },
    "veterinarian": {
      "type": "string"
    },
    "visit_type": {
      "type": "string",
      "enum": [
        "wellness",
        "sick_visit",
        "vaccination",
        "surgery",
        "dental",
        "emergency",
        "follow_up",
        "other"
      ],
      "default": "wellness"
    },
    "reason": {
      "type": "string"
    },
    "diagnosis": {
      "type": "string"
    },
    "treatment": {
      "type": "string",
      "description": "Treatments performed during the visit"
    },
    "follow_up_instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "vaccinations_given": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "rabies",
              "fvrcp",
              "felv",
              "custom"
            ]
          },
          "custom_name": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "medications_prescribed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "once_daily",
              "twice_daily",
              "thrice_daily",
              "as_needed"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "preventives_administered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "date_given": {
            "type": "string",
            "format": "date"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "every_3_months",
              "annual",
              "custom"
            ]
          },
          "custom_interval_days": {
            "type": "number"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "pdf",
              "image"
            ]
          }
        }
      }
    },
    "meds_added": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "pet_id",
    "date",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}