{
  "name": "NeonatalGroup",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string",
      "description": "Litter, intake group, or nursing mother group name"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "litter",
        "intake_group",
        "nursing_mother_group",
        "unrelated"
      ],
      "default": "litter"
    },
    "estimated_birth_date": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated date/time of birth for the group"
    },
    "mother_cat_name": {
      "type": "string",
      "description": "Mother cat name if applicable"
    },
    "mother_pet_id": {
      "type": "string",
      "description": "Reference to PetProfile if mother is a tracked pet"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "graduated",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "group_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}