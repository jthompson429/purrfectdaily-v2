{
  "name": "NeonatalGroup",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this group belongs to"
    },
    "group_name": {
      "type": "string",
      "description": "Litter, intake group, or nursing mother group name"
    },
    "group_type": {
      "type": "string",
      "enum": [
        "litter",
        "intake_group",
        "nursing_mother_group",
        "unrelated"
      ],
      "default": "litter"
    },
    "estimated_birth_date": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated date/time of birth for the group"
    },
    "mother_cat_name": {
      "type": "string",
      "description": "Mother cat name if applicable"
    },
    "mother_pet_id": {
      "type": "string",
      "description": "Reference to PetProfile if mother is a tracked pet"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "graduated",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "group_name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}