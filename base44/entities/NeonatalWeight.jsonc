{
  "name": "NeonatalWeight",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this weight record belongs to"
    },
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "weight_g": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time",
    "weight_g",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}