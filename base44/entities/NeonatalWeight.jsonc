{
  "name": "NeonatalWeight",
  "type": "object",
  "properties": {
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "weight_g": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time",
    "weight_g"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}