{
  "name": "WorkspaceInvitation",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "caregiver",
        "viewer"
      ],
      "default": "caregiver"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "revoked",
        "expired"
      ],
      "default": "pending"
    },
    "invited_by_user_id": {
      "type": "string"
    },
    "invited_by_email": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "email",
    "role"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        }
      ]
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}