{
  "name": "NeonatalElimination",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this elimination log belongs to"
    },
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "urinated": {
      "type": "boolean",
      "default": false
    },
    "defecated": {
      "type": "boolean",
      "default": false
    },
    "stimulated_by_human": {
      "type": "boolean",
      "default": true
    },
    "mom_assisted": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "delete": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    }
  }
}