{
  "name": "NeonatalElimination",
  "type": "object",
  "properties": {
    "kitten_id": {
      "type": "string",
      "description": "Associated neonatal kitten"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "urinated": {
      "type": "boolean",
      "default": false
    },
    "defecated": {
      "type": "boolean",
      "default": false
    },
    "stimulated_by_human": {
      "type": "boolean",
      "default": true
    },
    "mom_assisted": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}