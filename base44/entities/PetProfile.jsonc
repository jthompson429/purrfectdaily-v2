{
  "name": "PetProfile",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this pet belongs to"
    },
    "name": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "cat",
        "dog",
        "rabbit",
        "bird",
        "other"
      ],
      "default": "cat"
    },
    "breed": {
      "type": "string"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "default": "unknown"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Pet birth date; age is calculated from this"
    },
    "color_markings": {
      "type": "string"
    },
    "microchip_number": {
      "type": "string"
    },
    "spayed_neutered": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "default": "unknown"
    },
    "living_situation": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "foster"
      ],
      "default": "indoor"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "house_pet",
        "foster",
        "stray",
        "neonatal",
        "nursing_mother",
        "senior"
      ],
      "default": "house_pet"
    },
    "description": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "care_level": {
      "type": "string",
      "enum": [
        "routine",
        "special",
        "critical"
      ],
      "default": "routine"
    },
    "quarantine_status": {
      "type": "boolean",
      "default": false
    },
    "latest_weight": {
      "type": "number",
      "description": "Legacy cached weight; WeightLog is canonical"
    },
    "preferred_weight_unit": {
      "type": "string",
      "enum": [
        "kg",
        "lb"
      ],
      "default": "kg",
      "description": "Preferred display and entry unit for standard pet weights"
    },
    "body_condition_notes": {
      "type": "string"
    },
    "owner_foster_notes": {
      "type": "string"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "has_issues"
      ],
      "default": "healthy"
    },
    "health_issues": {
      "type": "string"
    },
    "known_allergies": {
      "type": "string",
      "description": "Known allergies or adverse reactions that may affect emergency care"
    },
    "emergency_instructions": {
      "type": "string",
      "description": "Pet-specific instructions for urgent or emergency situations"
    },
    "current_medications": {
      "type": "string"
    },
    "rabies_vaccine_due": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}