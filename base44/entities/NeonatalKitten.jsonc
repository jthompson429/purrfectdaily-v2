{
  "name": "NeonatalKitten",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this kitten belongs to"
    },
    "name": {
      "type": "string",
      "description": "Name or temporary ID"
    },
    "birth_date": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated date/time of birth"
    },
    "current_weight_g": {
      "type": "number",
      "description": "Current weight in grams"
    },
    "mother_present": {
      "type": "boolean",
      "default": true
    },
    "supplementing_kmr": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "group_id": {
      "type": "string",
      "description": "Reference to NeonatalGroup this kitten belongs to"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo URL for the kitten"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether kitten is currently in active neonatal care"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "default": "unknown"
    }
  },
  "required": [
    "name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}