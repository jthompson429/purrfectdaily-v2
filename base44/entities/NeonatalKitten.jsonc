{
  "name": "NeonatalKitten",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Workspace this kitten belongs to"
    },
    "name": {
      "type": "string",
      "description": "Name or temporary ID"
    },
    "birth_date": {
      "type": "string",
      "format": "date-time",
      "description": "Estimated date/time of birth"
    },
    "current_weight_g": {
      "type": "number",
      "description": "Current weight in grams"
    },
    "mother_present": {
      "type": "boolean",
      "default": true
    },
    "supplementing_kmr": {
      "type": "boolean",
      "default": false
    },
    "feeding_interval_hours": {
      "type": "number",
      "default": 8,
      "minimum": 0.5,
      "maximum": 24,
      "description": "Owner/admin-defined number of hours between scheduled feedings"
    },
    "notes": {
      "type": "string"
    },
    "group_id": {
      "type": "string",
      "description": "Reference to NeonatalGroup this kitten belongs to"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo URL for the kitten"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether kitten is currently in active neonatal care"
    },
    "available_for_adoption": {
      "type": "boolean",
      "default": false,
      "description": "Whether this kitten should appear in the adoption queue"
    },
    "adoption_available_date": {
      "type": "string",
      "format": "date",
      "description": "Date this kitten becomes available for adoption"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "graduated",
        "archived"
      ],
      "default": "active",
      "description": "Current neonatal lifecycle state"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When active neonatal care ended"
    },
    "archive_reason": {
      "type": "string",
      "enum": [
        "adopted",
        "transferred",
        "no_longer_in_care",
        "other",
        "moved_to_pet_profiles"
      ],
      "description": "Why the kitten left active neonatal care"
    },
    "pet_profile_id": {
      "type": "string",
      "description": "PetProfile created when this kitten graduated from neonatal care"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "default": "unknown"
    }
  },
  "required": [
    "name",
    "workspace_id"
  ],
  "rls": {
    "create": {
      "data.__rls_block": true
    },
    "read": {
      "data.workspace_id": {
        "$in": "{{user.data.workspace_ids}}"
      }
    },
    "update": {
      "data.__rls_block": true
    },
    "delete": {
      "data.__rls_block": true
    }
  }
}